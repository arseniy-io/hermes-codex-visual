+            supervisor = _get_compute_host_supervisor()
+            if operation == "stop" and params.get("checkpoint_id") is None:
+                # Purge this serving process's queue without an optimistic
+                # interrupt. The owning host validates any expected generation
+                # before the first actual cancellation signal.
