+    def tree_control(self, sid, *, operation, checkpoint_id=None, timeout=15,
+                         session_frame=None, on_complete=None):
+        self.start()
+        request_id = uuid.uuid4().hex
+        frame = {"type": "tree.control", "sid": sid, "request_id": request_id,
+                 "operation": operation, "checkpoint_id": checkpoint_id, "timeout": timeout,
+                 "session_frame": session_frame}
+        turn_id = "tree-continue-" + str(checkpoint_id or "")
+        if operation == "continue":
+            with self._lock:
+                self._pending_turns[turn_id] = (sid, on_complete)
+        ack = self._await_reply(frame, request_id, max(35.0, timeout + 5.0))
+        if operation == "continue" and not (ack.get("result") or {}).get("root_running"):
+            with self._lock:
+                self._pending_turns.pop(turn_id, None)
+        return ack
