+                if operation == "continue" and result.get("state") == "resumed":
+                    session["running"] = bool(result.get("root_running")) and supervisor.has_pending_turn(sid)
+                    session["_turn_cancel_requested"] = False
+        else:
+            from tui_gateway import server
+            from tui_gateway.hcv_stop_tree import control
